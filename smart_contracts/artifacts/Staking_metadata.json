			"kind": "dev",
			"methods": {
				"constructor": {
					"custom:oz-upgrades-unsafe-allow": "constructor"
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"paused()": {
					"details": "Returns true if the contract is paused, and false otherwise."
				},
				"proxiableUUID()": {
					"details": "Implementation of the ERC-1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				},
				"upgradeToAndCall(address,bytes)": {
					"custom:oz-upgrades-unsafe-allow-reachable": "delegatecall",
					"details": "Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."
				}
			},
			"title": "Staking (budgeted annual rewards, dynamic APY) + yearly periods with restart",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"calculateReward(address)": {
					"notice": "Public view wrapper to get current claimable reward for a user (includes unclaimed snapshot)"
				},
				"contractBalance()": {
					"notice": "Convenience balance view"
				},
				"currentAPY()": {
					"notice": "Current APY expressed in 1e18 precision. After rewardsEnd, returns 0 (since rewards no longer accrue)."
				},
				"dailyRatePerToken()": {
					"notice": "Current daily reward rate per token staked (for frontend helper) After rewardsEnd, returns 0."
				},
				"recoverExcessTokens(address,address,uint256)": {
					"notice": "Owner can recover accidentally sent tokens that are not cerToken."
				},
				"restartRewards(uint256)": {
					"notice": "Restart rewards for a new 365-day period. Requirements: - previous period must be finished (block.timestamp >= rewardsEnd) - newAnnualBudget must be > 0 IMPORTANT: - Before calling, owner should fund the contract with enough reward tokens   (transfer cerToken to this contract address)."
				},
				"rewardsActive()": {
					"notice": "Returns whether rewards are currently accruing."
				},
				"setAnnualRewardBudget(uint256)": {
					"notice": "Set annual reward budget (in token smallest units). Updates per-second rate."
				}
			},
			"notice": "Distributes a fixed annual reward budget proportionally to stakers. - Rewards accrue ONLY until `rewardsEnd` (1-year window). - After `rewardsEnd`, rewards stop increasing (APY returns 0). - Owner can \"refill\" tokens and call `restartRewards(newAnnualBudget)` to start a new 365-day period. Notes: - Contract must be funded with reward tokens by owner (transfer tokens to contract address). - totalStakedAmount is maintained on every stake/withdraw.",
			"version": 1
		}
	},
